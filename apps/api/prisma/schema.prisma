generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Company {
  id           String   @id @default(cuid())
  name         String
  logoUrl      String?
  addressLine1 String   @default("")
  addressLine2 String   @default("")
  postalCode   String   @default("")
  city         String   @default("")
  country      String   @default("FR")
  phone        String   @default("")
  email        String   @default("")
  siret        String   @default("")
  vatNumber    String   @default("")
  paymentTerms String   @default("Paiement à 30 jours")
  iban         String   @default("")
  bic          String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  settings          CompanySettings?
  clients           Client[]
  productCategories ProductCategory[]
  products          Product[]
  quotes            Quote[]
  invoices          Invoice[]
  creditNotes       CreditNote[]
  payments          Payment[]
  reminders         Reminder[]
  auditLogs         AuditLog[]
}

model CompanySettings {
  id                 String  @id @default(cuid())
  companyId          String  @unique
  company            Company @relation(fields: [companyId], references: [id])
  clientPrefix       String  @default("C")
  quotePrefix        String  @default("D")
  invoicePrefix      String  @default("F")
  creditPrefix       String  @default("A")
  nextClientSeq      Int     @default(1)
  nextQuoteSeq       Int     @default(1)
  nextInvoiceSeq     Int     @default(1)
  nextCreditSeq      Int     @default(1)
  nextProductSeq     Int     @default(1)
  defaultTaxRateBps  Int     @default(2000)
  defaultDueDays     Int     @default(30)
  pdfPrimaryColor    String  @default("#0F766E")
  legalMentions      String  @default("")
  termsAndConditions String  @default("")
}

model Client {
  id                    String    @id @default(cuid())
  companyId             String
  company               Company   @relation(fields: [companyId], references: [id])
  clientNumber          String
  name                  String
  type                  String
  status                String
  billingLine1          String
  billingLine2          String    @default("")
  billingPostalCode     String
  billingCity           String
  billingCountry        String    @default("FR")
  shippingSameAsBilling Boolean   @default(true)
  shippingLine1         String    @default("")
  shippingLine2         String    @default("")
  shippingPostalCode    String    @default("")
  shippingCity          String    @default("")
  shippingCountry       String    @default("FR")
  phone                 String    @default("")
  email                 String    @default("")
  siret                 String    @default("")
  vatNumber             String    @default("")
  notes                 String    @default("")
  balanceCents          Int       @default(0)
  deletedAt             DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  contacts              ClientContact[]
  quotes                Quote[]
  invoices              Invoice[]
  creditNotes           CreditNote[]

  @@unique([companyId, clientNumber])
  @@index([companyId, status])
  @@index([companyId, name])
}

model ClientContact {
  id        String  @id @default(cuid())
  clientId  String
  client    Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  firstName String
  lastName  String
  role      String  @default("")
  email     String  @default("")
  phone     String  @default("")
  isPrimary Boolean @default(false)
}

model ProductCategory {
  id        String    @id @default(cuid())
  companyId String
  company   Company   @relation(fields: [companyId], references: [id])
  name      String
  products  Product[]

  @@unique([companyId, name])
}

model Product {
  id                 String           @id @default(cuid())
  companyId          String
  company            Company          @relation(fields: [companyId], references: [id])
  sku                String
  name               String
  description        String           @default("")
  categoryId         String?
  category           ProductCategory? @relation(fields: [categoryId], references: [id])
  type               String
  unit               String
  purchasePriceCents Int              @default(0)
  salePriceHtCents   Int
  taxRateBps         Int              @default(2000)
  stockQty           Int?
  barcode            String           @default("")
  status             String           @default("ACTIVE")
  deletedAt          DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  quoteLines         QuoteLine[]
  invoiceLines       InvoiceLine[]

  @@unique([companyId, sku])
  @@index([companyId, status])
  @@index([companyId, type])
  @@index([companyId, name])
}

model Quote {
  id                  String      @id @default(cuid())
  companyId           String
  company             Company     @relation(fields: [companyId], references: [id])
  clientId            String
  client              Client      @relation(fields: [clientId], references: [id])
  quoteNumber         String
  status              String      @default("DRAFT")
  issueDate           DateTime
  validUntil          DateTime
  notes               String      @default("")
  terms               String      @default("")
  internalNotes       String      @default("")
  discountKind        String      @default("NONE")
  discountValue       Int         @default(0)
  travelFeeCents      Int         @default(0)
  travelFeeTaxRateBps Int         @default(2000)
  depositCents        Int         @default(0)
  linesHtCents        Int         @default(0)
  discountCents       Int         @default(0)
  totalHtCents        Int         @default(0)
  totalTaxCents       Int         @default(0)
  totalTtcCents       Int         @default(0)
  deletedAt           DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  lines               QuoteLine[]
  invoices            Invoice[]
  reminders           Reminder[]

  @@unique([companyId, quoteNumber])
  @@index([companyId, status])
  @@index([companyId, clientId])
}

model QuoteLine {
  id             String   @id @default(cuid())
  quoteId        String
  quote          Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product? @relation(fields: [productId], references: [id])
  position       Int
  designation    String
  description    String   @default("")
  quantity       Float
  unit           String
  unitPriceCents Int
  discountKind   String   @default("NONE")
  discountValue  Int      @default(0)
  taxRateBps     Int      @default(2000)
  lineHtCents    Int
  lineTaxCents   Int
  lineTtcCents   Int
}

model Invoice {
  id                  String        @id @default(cuid())
  companyId           String
  company             Company       @relation(fields: [companyId], references: [id])
  clientId            String
  client              Client        @relation(fields: [clientId], references: [id])
  quoteId             String?
  quote               Quote?        @relation(fields: [quoteId], references: [id])
  invoiceNumber       String?
  status              String        @default("DRAFT")
  issueDate           DateTime
  dueDate             DateTime
  notes               String        @default("")
  terms               String        @default("")
  internalNotes       String        @default("")
  discountKind        String        @default("NONE")
  discountValue       Int           @default(0)
  travelFeeCents      Int           @default(0)
  travelFeeTaxRateBps Int           @default(2000)
  depositCents        Int           @default(0)
  linesHtCents        Int           @default(0)
  discountCents       Int           @default(0)
  totalHtCents        Int           @default(0)
  totalTaxCents       Int           @default(0)
  totalTtcCents       Int           @default(0)
  amountPaidCents     Int           @default(0)
  creditedCents       Int           @default(0)
  amountDueCents      Int           @default(0)
  deletedAt           DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  lines               InvoiceLine[]
  payments            Payment[]
  creditNotes         CreditNote[]
  reminders           Reminder[]

  @@unique([companyId, invoiceNumber])
  @@index([companyId, status])
  @@index([companyId, clientId])
}

model InvoiceLine {
  id             String   @id @default(cuid())
  invoiceId      String
  invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product? @relation(fields: [productId], references: [id])
  position       Int
  designation    String
  description    String   @default("")
  quantity       Float
  unit           String
  unitPriceCents Int
  discountKind   String   @default("NONE")
  discountValue  Int      @default(0)
  taxRateBps     Int      @default(2000)
  lineHtCents    Int
  lineTaxCents   Int
  lineTtcCents   Int
}

model Payment {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amountCents Int
  method      String
  paidAt      DateTime
  reference   String   @default("")
  notes       String   @default("")
  createdAt   DateTime @default(now())
}

model CreditNote {
  id             String   @id @default(cuid())
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id])
  clientId       String
  client         Client   @relation(fields: [clientId], references: [id])
  invoiceId      String
  invoice        Invoice  @relation(fields: [invoiceId], references: [id])
  creditNumber   String?
  status         String   @default("DRAFT")
  kind           String
  issueDate      DateTime
  reason         String
  notes          String   @default("")
  taxRateBps     Int      @default(2000)
  totalHtCents   Int
  totalTaxCents  Int
  totalTtcCents  Int
  deletedAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([companyId, creditNumber])
  @@index([companyId, invoiceId])
}

model Reminder {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  target    String
  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id])
  quoteId   String?
  quote     Quote?   @relation(fields: [quoteId], references: [id])
  level     Int
  notes     String   @default("")
  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  entity    String
  entityId  String
  action    String
  payload   String   @default("{}")
  createdAt DateTime @default(now())
}
